{
  "about": "Curated catalog of agent skills installed via `npx skills` (vercel-labs/skills). `bin/skill` reads this file and shells out to `skills add` per item. Local skills live in this repo (repo: knowttl/awesome-ai); remote skills are fetched from their upstream. Add an item under `items`, then reference it from a bundle. Keys are the `skills` selector (the SKILL.md frontmatter `name`).",
  "defaults": {
    "agents": null
  },
  "items": {
    "agentsmd-init":            { "repo": "knowttl/awesome-ai" },
