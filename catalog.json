    "design-system":            { "repo": "knowttl/awesome-ai" },
    "dox-framework":            { "repo": "knowttl/awesome-ai" },
    "example-skill":            { "repo": "knowttl/awesome-ai" },
    "mind-clear":               { "repo": "knowttl/awesome-ai" },
    "opensrc-agents":           { "repo": "knowttl/awesome-ai" },
    "taste-developer":          { "repo": "knowttl/awesome-ai" },
    "taste-setup":              { "repo": "knowttl/awesome-ai" },

    "atelier":                  { "repo": "knowttl/atelier-axi", "setup": "npm install -g atelier-axi && atelier-axi setup hooks" },
